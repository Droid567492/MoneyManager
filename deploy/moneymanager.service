[Unit]
Description=MoneyManager Self-Hosted Finance PWA
After=network.target

[Service]
Type=simple
User=moneymanager
Group=moneymanager
WorkingDirectory=/opt/moneymanager
ExecStart=/usr/bin/node /opt/moneymanager/src/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
