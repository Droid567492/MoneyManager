# MoneyManager Environment Configuration
PORT=3000
HOST=0.0.0.0

# Optional: set Gemini API key here or configure it inside the app Settings tab
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Optional: override SQLite database and receipts paths
# DB_PATH=./data/moneymanager.db
# RECEIPTS_DIR=./data/receipts

# Set to "true" when behind an HTTPS reverse proxy (Apache/Caddy/Nginx over DDNS)
TRUST_PROXY=true
